#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define LSIDE  1
#define RSIDE  2
#define NAV  3
#define MS  4
#define SYS  5
/ {
	behaviors {
		Lht: left_hand_positional_hold_tap {
			compatible = "zmk,behavior-hold-tap";
			label = "LEFT_POSITIONAL_HOLD_TAP";
			#binding-cells = <2>;
			tapping-term-ms = <180>;
			quick-tap-ms = <0>;
			flavor = "balanced";
			bindings = <&kp>, <&kp>;
		};
		gt: globe_hold_tap {
			compatible = "zmk,behavior-hold-tap";
			label = "GLOBE_HOLD_TAP";
			#binding-cells = <2>;
			tapping-term-ms = <200>;
			quick-tap-ms = <150>;
			// tap-preferred: pressing another key while held still yields
			// the tap, so typing "ct" or ",a" cannot misfire into GLOBE.
			// Only a deliberate 200ms hold gives the modifier.
			flavor = "tap-preferred";
			bindings = <&kp>, <&kp>;
		};
		Rht: right_hand_positional_hold_tap {
			compatible = "zmk,behavior-hold-tap";
			label = "RIGHT_POSITIONAL_HOLD_TAP";
			#binding-cells = <2>;
			tapping-term-ms = <180>;
			quick-tap-ms = <0>;
			flavor = "balanced";
			bindings = <&kp>, <&kp>;
		};
	};
	
	combos {
		compatible = "zmk,combos";

		// require-prior-idle-ms suppresses a combo unless you paused first, so
		// mid-word rolls cannot fire it. Without it these pairs are unusable:
		// s+d appears 720x, k+l 1280x in a 236k word list, and l+; 134k times
		// in real source. Positions: 14=S 15=D 16=F 19=J 20=K 21=L 22=SEMI.
		combo_esc {
			timeout-ms = <50>;
			require-prior-idle-ms = <150>;
			key-positions = <14 15>;
			bindings = <&kp ESC>;
			layers = <BASE>;
		};

		combo_tab {
			timeout-ms = <50>;
			require-prior-idle-ms = <150>;
			key-positions = <15 16>;
			bindings = <&kp TAB>;
			layers = <BASE>;
		};

		combo_enter {
			timeout-ms = <50>;
			require-prior-idle-ms = <150>;
			key-positions = <19 20>;
			bindings = <&kp RETURN>;
			layers = <BASE>;
		};

		combo_bspc {
			timeout-ms = <50>;
			require-prior-idle-ms = <150>;
			key-positions = <20 21>;
			bindings = <&kp BSPC>;
			layers = <BASE>;
		};

		combo_del {
			timeout-ms = <50>;
			require-prior-idle-ms = <150>;
			key-positions = <21 22>;
			bindings = <&kp DELETE>;
			layers = <BASE>;
		};
	};

	keymap {
		compatible = "zmk,keymap";
		
		default_layer {
			bindings = <
			&kp LBKT			&kp Q			&kp W			&kp E			&kp R			&kp T						&kp Y				&kp U			&kp I			&kp O			&kp P			&kp RBKT
			&kp TAB				&kp A			&Lht LSFT S		&Lht LALT D		&Lht LGUI F		&kp G						&kp H				&Rht RGUI J		&Rht RALT K		&Rht RSHFT L	&kp SEMI		&kp APOS
			&kp ESC				&kp Z			&kp X			&gt GLOBE C		&Lht LCTRL V	&kp B						&kp N				&Rht RCTRL M	&gt GLOBE COMMA	&kp DOT			&kp FSLH		&kp RETURN
																&mo SYS			&mo NAV			&lt RSIDE BSPC				&lt LSIDE SPACE		&mo MS			&mo SYS
			>;
		};
		
		
		left_layer {
			bindings = <
			&kp F1				&kp F2			&kp F3			&kp F4			&kp F5			&kp F6						&none			&none				&none			&none			&none			&none
			&kp MINUS			&kp N1			&kp N2			&kp N3			&kp N4			&kp N5						&kp BSLH		&kp RGUI			&kp RALT		&kp RSHFT		&none			&none
			&trans				&none			&none			&none			&none			&none						&kp BSLH		&kp RCTRL			&none			&none			&none			&none
																&none			&none			&trans						&trans			&none				&none
			>;
		};
		
		right_layer {
			bindings = <
			&none				&none			&none			&none			&none			&none						&kp F7			&kp F8				&kp F9			&kp F10			&kp F11			&kp F12
			&none				&none			&kp LSHFT		&kp LALT		&kp LGUI		&kp GRAVE					&kp N6			&kp N7				&kp N8			&kp N9			&kp N0			&kp EQUAL
			&none				&none			&none			&none			&kp LCTRL		&kp TILDE					&none			&none				&none			&none			&none			&trans
																&none			&none			&trans						&none			&none				&none
			>;
		};
		
		nav_layer {
			bindings = <
			&none				&none			&none			&none			&none			&none						&kp PG_UP		&kp HOME			&kp UP			&kp END			&none			&none
			&none				&none			&kp LSHFT		&kp LALT		&kp LGUI		&none						&kp PG_DN		&kp LEFT			&kp DOWN		&kp RIGHT		&none			&none
			&none				&none			&none			&none			&kp LCTRL		&none						&none			&kp RETURN			&kp BSPC		&kp DELETE		&none			&none
																&none			&none			&trans						&none			&none				&none
			>;
		};
		
		ms_layer {
			bindings = <
			&none				&none			&msc SCRL_LEFT	&mmv MOVE_UP	&msc SCRL_RIGHT	&msc SCRL_UP				&none			&none				&none			&none			&none			&none
			&none				&none			&mmv MOVE_LEFT	&mmv MOVE_DOWN	&mmv MOVE_RIGHT	&msc SCRL_DOWN				&none			&kp RGUI			&kp RALT		&kp RSHFT		&none			&none
			&none				&none			&none			&none			&none			&none						&none			&kp RCTRL			&none			&none			&none			&none
																&mkp MCLK		&mkp RCLK		&mkp LCLK					&none			&trans				&none
			>;
		};
		
		sys_layer {
			bindings = <
			&sys_reset			&none			&none			&none			&kp C_VOL_UP	&studio_unlock				&none			&kp C_BRI_UP		&none			&none			&none			&sys_reset
			&bt BT_CLR			&bt BT_SEL 0	&bt BT_SEL 1	&bt BT_SEL 2	&kp C_VOL_DN	&none						&none			&kp C_BRI_DN		&none			&none			&none			&none
			&bootloader			&none			&none			&none			&none			&none						&none			&none				&none			&none			&none			&bootloader
																&trans			&none			&none						&none			&none				&trans
			>;
		};
		
	};
};