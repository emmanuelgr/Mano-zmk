#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define LSIDE  1
#define RSIDE  2
#define NAV  3
#define MS  4
/ {
	behaviors {
		// No home-row mods on lily58, by design. The Lht/Rht positional
		// hold-taps and the td_J/td_F wrappers that used them are gone.
		// ESC comes from the J+K combo below and &kp ESC on the base layer.

		td_Esc: tap_dance_esc {
			compatible = "zmk,behavior-tap-dance";
			label = "tap dance Esc";
			#binding-cells = <0>;
			tapping-term-ms = <200>;
			bindings = <&kp ESC>, <&kp GRAVE>;
		};

		td_lr: tap_dance_R_lower_right {
			compatible = "zmk,behavior-tap-dance";
			label = "tap dance overload left lower right key";
			#binding-cells = <0>;
			tapping-term-ms = <500>;
			bindings = <&lt RSIDE BSPC>, <&kp LBKT>;
		};
		td_ll: tap_dance_L_lower_left {
			compatible = "zmk,behavior-tap-dance";
			label = "tap dance overload right lower left key";
			#binding-cells = <0>;
			tapping-term-ms = <500>;
			bindings = <&lt LSIDE SPACE>, <&kp N>;
		};
	};

	combos {
		compatible = "zmk,combos";

		// J+K together = ESC. Positions are absolute indices into the
		// keymap matrix: 31 = J, 32 = K on the right home row.
		combo_esc {
			timeout-ms = <50>;
			key-positions = <31 32>;
			bindings = <&kp ESC>;
			layers = <BASE>;
		};
	};

	keymap {
		compatible = "zmk,keymap";

		default_layer {
			bindings = <
			&kp MINUS		&kp N1			&kp N2			&kp N3			&kp N4			&kp N5								&kp N6				&kp N7			&kp N8			&kp N9			&kp N0			&kp EQUAL
			&kp LBKT		&kp Q			&kp W			&kp E			&kp R			&kp T								&kp Y				&kp U			&kp I			&kp O			&kp P			&kp RBKT
			&kp TAB			&kp A			&kp S			&kp D			&kp F			&kp G								&kp H				&kp J			&kp K			&kp L			&kp SEMI		&kp APOS
			&kp ESC			&kp Z			&kp X			&kp C			&kp V			&kp B			&none	&none		&kp N				&kp M			&kp COMMA		&kp DOT			&kp FSLH		&kp RETURN
											&none			&none			&mo NAV			&lt RSIDE BSPC						&lt LSIDE SPACE		&mo MS			&none			&none
			>;
		};


		left_layer {
			bindings = <
			&trans			&trans			&trans			&trans			&trans			&trans								&none				&none			&none			&kp C_VOL_DN	&kp C_VOL_UP	&kp C_MUTE
 			&trans			&trans			&trans			&trans			&trans			&trans								&kp F7				&kp F8			&kp F9			&kp F10			&kp F11			&kp F12		
			&kp TAB			&trans			&trans			&trans			&trans			&trans								&kp BSLH			&kp RGUI		&kp RALT		&kp RSHFT		&none			&none
			&kp ESC			&trans			&trans			&trans			&trans			&trans			&none	&none		&kp PIPE			&kp RCTRL		&kp BSPC		&kp DELETE		&none			&kp RETURN
											&none			&none			&none			&trans								&trans				&none			&none			&none
			>;
		};
 
		right_layer {
			bindings = <
			&kp C_BRI_DEC	&kp C_BRI_INC	&none			&none			&none			&none								&trans				&trans			&trans			&trans			&trans			&trans
			&kp F1			&kp F2			&kp F3			&kp F4			&kp F5			&kp F6								&trans				&trans			&trans			&trans			&trans			&trans	
			&kp TAB			&none			&kp LSHFT		&kp LALT		&kp LGUI		&kp GRAVE							&trans				&trans			&trans			&trans			&trans			&trans
			&kp ESC			&none			&none			&none			&kp LCTRL		&kp TILDE		&none	&none		&trans				&trans			&trans			&trans			&trans			&kp RETURN
											&none			&none			&none			&trans								&trans				&none			&none			&none
			>;
		};

		nav_layer {
			bindings = <
			&none			&none			&none			&none			&none			&none								&none				&none			&none			&none			&none			&none
			&none			&none			&none			&none			&none			&none								&kp PG_UP			&kp HOME		&kp UP			&kp END			&none			&none
			&kp TAB			&none			&kp LSHFT		&kp LALT		&kp LGUI		&none								&kp PG_DN			&kp LEFT		&kp DOWN		&kp RIGHT		&none			&none
			&kp ESC			&none			&none			&none			&kp LCTRL		&none			&none	&none		&kp PRINTSCREEN 	&none			&kp BSPC		&kp DELETE		&none			&kp RETURN
											&none			&none			&none			&trans								&trans				&none			&none			&none
			>;
		};

		ms_layer {
			bindings = <
			&bootloader		&studio_unlock	&none			&none			&none			&none								&bt BT_CLR			&bt BT_SEL 0	&bt BT_SEL 1	&bt BT_SEL 2	&bt BT_SEL 3	&bt BT_SEL 4
			&none			&none			&msc SCRL_LEFT	&mmv MOVE_UP	&msc SCRL_RIGHT	&msc SCRL_UP						&none				&none			&none			&none			&none			&none
			&kp TAB			&none			&mmv MOVE_LEFT	&mmv MOVE_DOWN	&mmv MOVE_RIGHT	&msc SCRL_DOWN						&none				&kp RGUI		&kp RALT		&kp RSHFT		&none			&none
			&kp ESC			&none			&none			&none			&none			&none			&none	&none		&none				&kp RCTRL		&kp BSPC		&kp DELETE		&none			&kp RETURN
											&none			&mkp MCLK		&mkp LCLK		&mkp RCLK							&none				&trans			&none			&none
			>;
		};

	};
};