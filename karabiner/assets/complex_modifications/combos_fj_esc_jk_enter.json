{
  "title": "Combos: f+j Escape, j+k Enter, k+x forward Delete (matches ZMK)",
  "rules": [
    {
      "description": "Press f and j together to send Escape",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "simultaneous": [
              {
                "key_code": "f"
              },
              {
                "key_code": "j"
              }
            ],
            "simultaneous_options": {
              "key_down_order": "insensitive",
              "key_up_order": "insensitive",
              "detect_key_down_uninterruptedly": true
            },
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "escape"
            }
          ],
          "parameters": {
            "basic.simultaneous_threshold_milliseconds": 50
          }
        }
      ]
    },
    {
      "description": "Press j and k together to send Enter",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "simultaneous": [
              {
                "key_code": "j"
              },
              {
                "key_code": "k"
              }
            ],
            "simultaneous_options": {
              "key_down_order": "insensitive",
              "key_up_order": "insensitive",
              "detect_key_down_uninterruptedly": true
            },
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "return_or_enter"
            }
          ],
          "parameters": {
            "basic.simultaneous_threshold_milliseconds": 50
          }
        }
      ]
    },
    {
      "description": "Press k and x together to send forward Delete",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "simultaneous": [
              {
                "key_code": "k"
              },
              {
                "key_code": "x"
              }
            ],
            "simultaneous_options": {
              "key_down_order": "insensitive",
              "key_up_order": "insensitive",
              "detect_key_down_uninterruptedly": true
            },
            "modifiers": {
              "optional": [
                "any"
              ]
            }
          },
          "to": [
            {
              "key_code": "delete_forward"
            }
          ],
          "parameters": {
            "basic.simultaneous_threshold_milliseconds": 50
          }
        }
      ]
    }
  ]
}
